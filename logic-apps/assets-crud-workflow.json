{
  "$schema": "https://schema.management.azure.com/providers/Microsoft.Logic/schemas/2016-06-01/workflowdefinition.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "backendBaseUrl": {
      "type": "String",
      "defaultValue": "https://cloudshareapiasbin2.azurewebsites.net/api/assets"
    }
  },
  "triggers": {
    "manual": {
      "type": "Request",
      "kind": "Http",
      "inputs": {
        "method": "POST",
        "schema": {
          "type": "object",
          "properties": {
            "method": {
              "type": "string"
            },
            "payload": {
              "type": "object"
            },
            "assetId": {
              "type": "string"
            }
          }
        }
      }
    }
  },
  "actions": {
    "resolve_backend_url": {
      "type": "Compose",
      "inputs": "@{if(empty(coalesce(triggerOutputs()?['queries']?['assetId'], triggerBody()?['assetId'])), parameters('backendBaseUrl'), concat(parameters('backendBaseUrl'), '/', coalesce(triggerOutputs()?['queries']?['assetId'], triggerBody()?['assetId'])))}"
    },
    "route_by_method": {
      "type": "If",
      "runAfter": {
        "resolve_backend_url": [
          "Succeeded"
        ]
      },
      "expression": "@equals(toUpper(coalesce(triggerBody()?['method'], 'GET')), 'GET')",
      "actions": {
        "invoke_backend_api_get": {
          "type": "Http",
          "inputs": {
            "method": "GET",
            "uri": "@outputs('resolve_backend_url')",
            "headers": {
              "x-origin": "logic-app"
            }
          }
        },
        "response_get": {
          "type": "Response",
          "kind": "Http",
          "runAfter": {
            "invoke_backend_api_get": [
              "Succeeded",
              "Failed"
            ]
          },
          "inputs": {
            "statusCode": "@outputs('invoke_backend_api_get')['statusCode']",
            "body": "@body('invoke_backend_api_get')"
          }
        }
      },
      "else": {
        "actions": {
          "invoke_backend_api_write": {
            "type": "Http",
            "inputs": {
              "method": "@coalesce(triggerBody()?['method'], 'POST')",
              "uri": "@outputs('resolve_backend_url')",
              "headers": {
                "x-origin": "logic-app"
              },
              "body": "@coalesce(triggerBody()?['payload'], triggerBody())"
            }
          },
          "response_write": {
            "type": "Response",
            "kind": "Http",
            "runAfter": {
              "invoke_backend_api_write": [
                "Succeeded",
                "Failed"
              ]
            },
            "inputs": {
              "statusCode": "@outputs('invoke_backend_api_write')['statusCode']",
              "body": "@body('invoke_backend_api_write')"
            }
          }
        }
      }
    }
  },
  "outputs": {}
}
