{
    "definition":  {
                       "$schema":  "https://schema.management.azure.com/providers/Microsoft.Logic/schemas/2016-06-01/workflowdefinition.json#",
                       "contentVersion":  "1.0.0.0",
                       "parameters":  {
                                          "backendBaseUrl":  {
                                                                 "type":  "String",
                                                                 "defaultValue":  "https://cloudshareapiasbin2.azurewebsites.net/api/assets"
                                                             }
                                      },
                       "triggers":  {
                                        "manual":  {
                                                       "type":  "Request",
                                                       "kind":  "Http",
                                                       "inputs":  {
                                                                      "method":  "POST",
                                                                      "schema":  {
                                                                                     "type":  "object",
                                                                                     "properties":  {
                                                                                                        "method":  {
                                                                                                                       "type":  "string"
                                                                                                                   },
                                                                                                        "payload":  {
                                                                                                                        "type":  "object"
                                                                                                                    },
                                                                                                        "assetId":  {
                                                                                                                        "type":  "string"
                                                                                                                    }
                                                                                                    }
                                                                                 }
                                                                  }
                                                   }
                                    },
                       "actions":  {
                                       "resolve_backend_url":  {
                                                                   "type":  "Compose",
                                                                   "inputs":  "@{if(empty(coalesce(triggerOutputs()?[\u0027queries\u0027]?[\u0027assetId\u0027], triggerBody()?[\u0027assetId\u0027])), parameters(\u0027backendBaseUrl\u0027), concat(parameters(\u0027backendBaseUrl\u0027), \u0027/\u0027, coalesce(triggerOutputs()?[\u0027queries\u0027]?[\u0027assetId\u0027], triggerBody()?[\u0027assetId\u0027])))}"
                                                               },
                                       "route_by_method":  {
                                                               "type":  "If",
                                                               "runAfter":  {
                                                                                "resolve_backend_url":  [
                                                                                                            "Succeeded"
                                                                                                        ]
                                                                            },
                                                               "expression":  "@equals(toUpper(coalesce(triggerBody()?[\u0027method\u0027], \u0027GET\u0027)), \u0027GET\u0027)",
                                                               "actions":  {
                                                                               "invoke_backend_api_get":  {
                                                                                                              "type":  "Http",
                                                                                                              "inputs":  {
                                                                                                                             "method":  "GET",
                                                                                                                             "uri":  "@outputs(\u0027resolve_backend_url\u0027)",
                                                                                                                             "headers":  {
                                                                                                                                             "x-origin":  "logic-app"
                                                                                                                                         }
                                                                                                                         }
                                                                                                          },
                                                                               "response_get":  {
                                                                                                    "type":  "Response",
                                                                                                    "kind":  "Http",
                                                                                                    "runAfter":  {
                                                                                                                     "invoke_backend_api_get":  [
                                                                                                                                                    "Succeeded",
                                                                                                                                                    "Failed"
                                                                                                                                                ]
                                                                                                                 },
                                                                                                    "inputs":  {
                                                                                                                   "statusCode":  "@outputs(\u0027invoke_backend_api_get\u0027)[\u0027statusCode\u0027]",
                                                                                                                   "body":  "@body(\u0027invoke_backend_api_get\u0027)"
                                                                                                               }
                                                                                                }
                                                                           },
                                                               "else":  {
                                                                            "actions":  {
                                                                                            "invoke_backend_api_write":  {
                                                                                                                             "type":  "Http",
                                                                                                                             "inputs":  {
                                                                                                                                            "method":  "@coalesce(triggerBody()?[\u0027method\u0027], \u0027POST\u0027)",
                                                                                                                                            "uri":  "@outputs(\u0027resolve_backend_url\u0027)",
                                                                                                                                            "headers":  {
                                                                                                                                                            "x-origin":  "logic-app"
                                                                                                                                                        },
                                                                                                                                            "body":  "@coalesce(triggerBody()?[\u0027payload\u0027], triggerBody())"
                                                                                                                                        }
                                                                                                                         },
                                                                                            "response_write":  {
                                                                                                                   "type":  "Response",
                                                                                                                   "kind":  "Http",
                                                                                                                   "runAfter":  {
                                                                                                                                    "invoke_backend_api_write":  [
                                                                                                                                                                     "Succeeded",
                                                                                                                                                                     "Failed"
                                                                                                                                                                 ]
                                                                                                                                },
                                                                                                                   "inputs":  {
                                                                                                                                  "statusCode":  "@outputs(\u0027invoke_backend_api_write\u0027)[\u0027statusCode\u0027]",
                                                                                                                                  "body":  "@body(\u0027invoke_backend_api_write\u0027)"
                                                                                                                              }
                                                                                                               }
                                                                                        }
                                                                        }
                                                           }
                                   },
                       "outputs":  {

                                   }
                   }
}
