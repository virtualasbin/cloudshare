{
  "definition": {
    "$schema": "https://schema.management.azure.com/providers/Microsoft.Logic/schemas/2016-06-01/workflowdefinition.json#",
    "contentVersion": "1.0.0.0",
    "parameters": {
      "backendBaseUrl": {
        "type": "String",
        "defaultValue": "https://cloudshareapiasbin2.azurewebsites.net/api/assets"
      }
    },
    "triggers": {
      "manual": {
        "type": "Request",
        "kind": "Http",
        "inputs": {
          "method": "POST",
          "schema": {
            "type": "object",
            "properties": {
              "name": { "type": "string" },
              "contentType": { "type": "string" },
              "fileBase64": { "type": "string" },
              "tags": { "type": "array", "items": { "type": "string" } }
            },
            "required": ["name", "contentType", "fileBase64"]
          }
        }
      }
    },
    "actions": {
      "create_individual_asset": {
        "type": "Http",
        "inputs": {
          "method": "POST",
          "uri": "@parameters('backendBaseUrl')",
          "headers": {
            "x-origin": "cia"
          },
          "body": "@triggerBody()"
        }
      },
      "response": {
        "type": "Response",
        "kind": "Http",
        "runAfter": {
          "create_individual_asset": [
            "Succeeded",
            "Failed"
          ]
        },
        "inputs": {
          "statusCode": "@outputs('create_individual_asset')['statusCode']",
          "body": "@body('create_individual_asset')"
        }
      }
    },
    "outputs": {}
  }
}
