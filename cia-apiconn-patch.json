                                                                                                                           "contentType":  "@triggerBody()?[\u0027contentType\u0027]",
                                                                                                                           "fileBase64":  "@triggerBody()?[\u0027fileBase64\u0027]",
                                                                                                                           "tags":  "@triggerBody()?[\u0027tags\u0027]"
                                                                                                                       }
                                                                                                          }
                                                                                           }
                                                      },
                                          "contentVersion":  "1.0.0.0",
                                          "outputs":  {

                                                      },
