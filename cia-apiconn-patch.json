                                                                                                                              "x-cosmos-endpoint":  "@outputs(\u0027cosmos_endpoint_reference\u0027)",
                                                                                                                              "x-cosmos-connection":  "@outputs(\u0027cosmos_connection_reference\u0027)",
                                                                                                                              "x-main-connection":  "@outputs(\u0027primary_connection_reference\u0027)"
                                                                                                                          },
                                                                                                              "body":  {
