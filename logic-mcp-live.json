  "definition": {
    "$schema": "https://schema.management.azure.com/providers/Microsoft.Logic/schemas/2016-06-01/workflowdefinition.json#",
    "actions": {
      "resolve_backend_url": {
        "inputs": "@{if(empty(coalesce(triggerOutputs()?['queries']?['assetId'], triggerBody()?['assetId'])), parameters('backendBaseUrl'), concat(parameters('backendBaseUrl'), '/', coalesce(triggerOutputs()?['queries']?['assetId'], triggerBody()?['assetId'])))}",
        "type": "Compose"
      },
      "route_by_method": {
        "actions": {
          "invoke_backend_api_get": {
            "inputs": {
              "headers": {
                "x-origin": "logic-app"
              },
              "method": "GET",
              "uri": "@outputs('resolve_backend_url')"
            },
            "type": "Http"
          },
          "response_get": {
            "inputs": {
              "body": "@body('invoke_backend_api_get')",
              "statusCode": "@outputs('invoke_backend_api_get')['statusCode']"
            },
            "kind": "Http",
            "runAfter": {
              "invoke_backend_api_get": [
                "Succeeded",
                "Failed"
              ]
            },
            "type": "Response"
          }
        },
        "else": {
          "actions": {
            "invoke_backend_api_write": {
              "inputs": {
                "body": "@coalesce(triggerBody()?['payload'], triggerBody())",
                "headers": {
                  "x-origin": "logic-app"
                },
                "method": "@coalesce(triggerBody()?['method'], 'POST')",
                "uri": "@outputs('resolve_backend_url')"
              },
              "type": "Http"
            },
            "response_write": {
              "inputs": {
                "body": "@body('invoke_backend_api_write')",
                "statusCode": "@outputs('invoke_backend_api_write')['statusCode']"
              },
              "kind": "Http",
              "runAfter": {
                "invoke_backend_api_write": [
                  "Succeeded",
                  "Failed"
                ]
              },
              "type": "Response"
            }
          }
        },
        "expression": "@equals(toUpper(coalesce(triggerBody()?['method'], 'GET')), 'GET')",
        "runAfter": {
          "resolve_backend_url": [
            "Succeeded"
          ]
        },
        "type": "If"
      }
    },
    "contentVersion": "1.0.0.0",
    "outputs": {},
    "parameters": {
      "backendBaseUrl": {
        "type": "String"
      }
    },
    "triggers": {
      "manual": {
        "inputs": {
          "method": "POST",
          "schema": {
            "properties": {
              "assetId": {
                "type": "string"
              },
              "method": {
                "type": "string"
              },
              "payload": {
                "type": "object"
              }
            },
            "type": "object"
          }
        },
        "kind": "Http",
        "type": "Request"
      }
    }
  },
